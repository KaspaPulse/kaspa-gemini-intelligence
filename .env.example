# ==============================================================================
# TELEGRAM BOT CONFIGURATION
# ==============================================================================
BOT_TOKEN=PUT_YOUR_TELEGRAM_BOT_TOKEN_HERE
ADMIN_ID=PUT_YOUR_TELEGRAM_ADMIN_ID_HERE

# ==============================================================================
# KASPA NODE & DATABASE
# ==============================================================================
NODE_URL_01=wss://kaspadns.net/json
DATABASE_URL=postgres://postgres:PUT_PASSWORD_HERE@127.0.0.1:5433/kaspa_dev?sslmode=disable

# ==============================================================================
# EXTERNAL APIs
# ==============================================================================
COINGECKO_API_URL=https://api.coingecko.com/api/v3/simple/price?ids=kaspa&vs_currencies=usd&include_market_cap=true
KASPA_API_PRICE_URL=https://api.kaspa.org/info/price
KASPA_API_MCAP_URL=https://api.kaspa.org/info/marketcap

# ==============================================================================
# PRODUCTION SETTINGS
# ==============================================================================
APP_ENV=production
RUST_LOG=info
ENABLE_VERBOSE_LOGS=false
DB_MAX_CONNECTIONS=10
HTTP_TIMEOUT_SECS=10
HTTP_CONNECT_TIMEOUT_SECS=5

# ==============================================================================
# TELEGRAM PROTECTION
# ==============================================================================
MAX_WALLETS_PER_USER=10
RATE_LIMIT_COMMANDS_PER_SECOND=1
RATE_LIMIT_CALLBACKS_PER_SECOND=3
RATE_LIMIT_ADD_WALLET_PER_MINUTE=5
MAX_RAW_MESSAGE_CHARS=512
MAX_WALLET_ADDRESS_CHARS=120
LOG_MAX_CHARS=5000

# ==============================================================================
# WEBHOOK SETTINGS
# Keep USE_WEBHOOK=false if you run polling.
# ==============================================================================
USE_WEBHOOK=false
WEBHOOK_DOMAIN=your-domain.com
WEBHOOK_PORT=8443
WEBHOOK_BIND=127.0.0.1
WEBHOOK_SECRET_TOKEN=PUT_RANDOM_WEBHOOK_SECRET_HERE

# Bot event log retention
BOT_EVENT_LOG_RETENTION_DAYS=60

# /blocks wallet history page size. Default in code is 15. Allowed range: 5-50.
BLOCKS_HISTORY_PAGE_SIZE=15

# Stored KAS/USD prices for /blocks values.
# /blocks reads DB only; price sync stores current and historical daily prices.
COINGECKO_MARKET_CHART_RANGE_URL=https://api.coingecko.com/api/v3/coins/kaspa/market_chart/range
KAS_PRICE_HISTORY_ENABLED=true
KAS_PRICE_REFRESH_INTERVAL_SECS=3600
KAS_PRICE_BACKFILL_LIMIT_DAYS=180

# Kaspa monitoring runtime (Batch 4B)
# subscription_preferred uses native VirtualDaaScoreChanged notifications with polling fallback.
# polling_only disables native notification registration and uses periodic polling only.
KASPA_MONITOR_MODE=subscription_preferred
KASPA_MONITOR_POLL_INTERVAL_SECS=10
KASPA_MONITOR_RECONCILIATION_INTERVAL_SECS=60
KASPA_SUBSCRIPTION_MIN_SCAN_INTERVAL_SECS=2
KASPA_SUBSCRIPTION_RETRY_SECS=30
KASPA_SUBSCRIPTION_SUPERVISOR_RESTART_SECS=5

# Operational readiness policy
READINESS_REQUIRE_NODE=true
# Effective only when KASPA_MONITOR_MODE=subscription_preferred.
READINESS_REQUIRE_SUBSCRIPTION=true
READINESS_MAX_SCAN_AGE_SECS=120
READINESS_MAX_FAILED_QUEUE_ITEMS=0

DELIVERY_QUEUE_METRICS_INTERVAL_SECS=30
